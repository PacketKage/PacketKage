# ---------------------------------------------------------------------------
# PacketKage configuration
#
# Copy to .env and fill in. Docker Compose auto-loads .env from this directory,
# so `docker compose up` picks these up; the native backend reads the same
# PACKETKAGE_* variables straight from the environment.
# ---------------------------------------------------------------------------

# --- Public URL ------------------------------------------------------------
# The browser-facing base URL of PacketKage. Used to build post-login
# redirects, so it must be the URL users actually visit. Behind TLS this is
# https://packetkage.example.com.
PACKETKAGE_PUBLIC_URL=http://localhost:8000

# --- OIDC / Authentik (required) ------------------------------------------
# Authentication is the only way in. While PACKETKAGE_OIDC_ISSUER is unset the
# API refuses to serve protected routes (503) rather than running wide open.
#
# You can either fill these in here, or leave them unset and complete the
# first-run wizard at /setup (opens automatically while unconfigured; values are
# persisted to the data volume). Anything set here is authoritative and shown
# read-only in the wizard — environment variables always win.
PACKETKAGE_OIDC_ISSUER=http://authentik:9000/application/o/packetkage/
PACKETKAGE_OIDC_CLIENT_ID=replace-with-authentik-client-id
PACKETKAGE_OIDC_CLIENT_SECRET=replace-with-authentik-client-secret
# Must match the redirect URI registered on the Authentik provider exactly.
# Derived from PACKETKAGE_PUBLIC_URL + /api/auth/callback when left blank.
PACKETKAGE_OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback
PACKETKAGE_OIDC_SCOPE=openid profile email
# Claim carrying Authentik group memberships.
PACKETKAGE_OIDC_GROUPS_CLAIM=groups

# --- Role mapping ----------------------------------------------------------
PACKETKAGE_ADMIN_GROUP=packetkage-admin
PACKETKAGE_ANALYST_GROUP=packetkage-analyst

# --- Sessions --------------------------------------------------------------
# Seconds a login lasts (default 8h).
# PACKETKAGE_SESSION_TTL=28800
# Force the Secure cookie flag on/off. Defaults to on when the public URL or
# redirect URI is https://. Leave unset behind a TLS reverse proxy.
# PACKETKAGE_SESSION_SECURE=1

# --- Storage (container paths; the image sets these by default) -----------
# PACKETKAGE_DB=sqlite:////data/packetkage.db
# PACKETKAGE_UPLOAD_DIR=/data/uploads

# --- First-run setup wizard ----------------------------------------------
# Where the wizard persists OIDC config (default: next to the upload dir, i.e.
# /data/setup.json in the container; 0600). The bootstrap token that guards
# remote setup access is written alongside it as setup-token.
# PACKETKAGE_SETUP_FILE=/data/setup.json
# Pin the bootstrap token instead of accepting the generated one (optional).
# PACKETKAGE_SETUP_TOKEN=

# ---------------------------------------------------------------------------
# Bundled Authentik stack (docker-compose.authentik.yml only)
# ---------------------------------------------------------------------------
# Generate strong values: openssl rand -base64 36
AUTHENTIK_SECRET_KEY=replace-with-a-long-random-secret
AUTHENTIK_POSTGRESQL__PASSWORD=replace-with-a-strong-db-password
# Used once to create the initial akadmin account (and API token for automation).
AUTHENTIK_BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password
AUTHENTIK_BOOTSTRAP_TOKEN=replace-with-a-bootstrap-api-token
